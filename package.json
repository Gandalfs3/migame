{
  "name": "migame-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run dev -w @migame/server\" \"npm run dev -w @migame/client\"",
    "serve:lan": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run dev -w @migame/server\" \"npm run dev -w @migame/client\"",
    "build": "npm run build --workspaces",
    "grafify": "node scripts/grafify.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
